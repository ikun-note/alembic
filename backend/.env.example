# Backend + PG container config. Copy to .env and adjust.
# Read by both the app (pydantic-settings) and the PG container (compose --env-file).
# Password is the only sensitive value; keep .env gitignored.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=alembic_lab
POSTGRES_DB=alembic_lab
POSTGRES_PASSWORD=change_me
